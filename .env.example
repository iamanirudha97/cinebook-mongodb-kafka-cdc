# Copy this file to .env and fill in your credentials.
# Never commit .env with real secrets.

MONGODB_URI=mongodb+srv://<APP_USER>:<APP_PASSWORD>@<CLUSTER>.mongodb.net/?appName=CineBook
MONGODB_DB=cinebook
MONGODB_ADMIN_URI=mongodb+srv://<ADMIN_USER>:<ADMIN_PASSWORD>@<CLUSTER>.mongodb.net/?appName=CineBook

LOG_LEVEL=INFO

# Confluent Cloud Kafka (for CDC consumer)
KAFKA_BOOTSTRAP_SERVERS=<CLUSTER_ID>.<REGION>.<PROVIDER>.confluent.cloud:9092
KAFKA_API_KEY=<KAFKA_API_KEY>
KAFKA_API_SECRET=<KAFKA_API_SECRET>