# Base URL for the CineBook FastAPI backend.
# In local dev, `/api` is proxied by Vite (vite.config.ts) to http://127.0.0.1:8000
# so requests work without modifying the backend to add CORS middleware.
# If CORS is enabled on the backend, you can set VITE_API_BASE_URL=http://127.0.0.1:8000.
VITE_API_BASE_URL=/api